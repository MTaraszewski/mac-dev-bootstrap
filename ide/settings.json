{
  // Written to the User settings dir of every VS Code-family editor found,
  // by scripts/setup-ide.sh. Your previous file is backed up next to it.
  //
  // DELIBERATELY EDITOR-NEUTRAL: nothing in here breaks the official VS Code
  // build or VSCodium. Editor-specific keys (notably the remote.SSH.* trio
  // that open-remote-ssh needs) live in ide/settings.vscodium-remote-ssh.json
  // — they would BREAK Microsoft's Remote-SSH if applied to official VS Code.

  // ── telemetry ────────────────────────────────────────────────────────
  // VSCodium has the MS endpoints stripped at build time, so there this is
  // belt-and-braces — but it also silences EXTENSIONS that read the setting,
  // and on official VS Code it is the only lever there is.
  "telemetry.telemetryLevel": "off",
  "telemetry.enableTelemetry": false,
  "telemetry.enableCrashReporter": false,

  // ── residual outbound chatter ────────────────────────────────────────
  "workbench.enableExperiments": false,
  "workbench.settings.enableNaturalLanguageSearch": false,
  "npm.fetchOnlinePackageInfo": false,
  "update.showReleaseNotes": false,
  // autofetch talks to every remote of every open repo on a timer. Off by
  // default here so a work machine is not pinging private hosts unprompted.
  "git.autofetch": false,
  "extensions.autoCheckUpdates": true,

  // ── editor ───────────────────────────────────────────────────────────
  "files.autoSave": "onFocusChange",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "editor.minimap.enabled": false,
  "editor.rulers": [88, 100],
  "editor.formatOnSave": true,
  "editor.fontFamily": "Fira Code, Monaco, monospace",
  "editor.fontLigatures": true,
  "editor.bracketPairColorization.enabled": true,
  "window.restoreWindows": "none",
  "workbench.iconTheme": "material-icon-theme",
  "terminal.integrated.defaultProfile.osx": "zsh",

  // ── python ───────────────────────────────────────────────────────────
  // Jedi, not Pylance: Pylance is proprietary and licence-restricted to
  // official MS builds, so VSCodium cannot have it. Harmless on VS Code too.
  "python.languageServer": "Jedi",
  "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" },

  // ── git ──────────────────────────────────────────────────────────────
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "diffEditor.ignoreTrimWhitespace": false
}
